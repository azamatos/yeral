{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalDependencies": [".node-version"],
  "globalPassThroughEnv": ["PORT_BASE", "CLOUDFLARE_API_TOKEN", "CLOUDFLARE_ACCOUNT_ID", "GITHUB_TOKEN"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["VITE_*", "PORT_BASE"],
      "outputs": ["dist/**", "storybook-static/**"]
    },
    "transit": {
      "dependsOn": ["^transit"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^transit"]
    },
    "lint:fsd": {},
    "typecheck": {
      "dependsOn": ["^transit"]
    },
    "test": {
      "outputs": ["coverage/**"],
      "passThroughEnv": ["TEST_DATABASE_URL"],
      "dependsOn": ["^transit"]
    },
    "deploy": {
      "cache": false
    }
  }
}
