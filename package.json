{
  "name": "yeral",
  "private": true,
  "description": "\u00dderal monorepo: client marketplace, business workspace, cms, api and the design system",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:fsd": "turbo run lint:fsd",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:stories": "turbo run test --filter=@yeral/storybook",
    "e2e": "turbo run e2e",
    "check": "turbo run lint lint:fsd typecheck test && prettier --check .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gen": "turbo gen",
    "book": "node scripts/book.mjs",
    "db:up": "docker compose -f infra/docker/compose.dev.yml up -d --wait",
    "db:down": "docker compose -f infra/docker/compose.dev.yml down",
    "db:setup": "pnpm --filter @yeral/api db:setup",
    "db:generate": "pnpm --filter @yeral/api db:generate",
    "docker:up": "docker compose -f infra/docker/compose.yml up -d --build --wait",
    "docker:down": "docker compose -f infra/docker/compose.yml down",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@turbo/gen": "catalog:",
    "@yeral/config": "workspace:*",
    "lefthook": "catalog:",
    "prettier": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  }
}
