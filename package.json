{
  "name": "yeral",
  "private": true,
  "description": "Yeral monorepo: landing, client, business, cms, api and the design system",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:fsd": "turbo run lint:fsd",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:stories": "turbo run test --filter=@yeral/storybook",
    "check": "turbo run lint lint:fsd typecheck test && prettier --check .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gen": "turbo gen",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "tag-release": "changeset tag",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@changesets/changelog-github": "catalog:",
    "@changesets/cli": "catalog:",
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@neon/config": "^1.9.1",
    "@neon/env": "^1.6.1",
    "@turbo/gen": "catalog:",
    "@yeral/config": "workspace:*",
    "lefthook": "catalog:",
    "prettier": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  }
}
