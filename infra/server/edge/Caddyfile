# Every project's sites live in sites/*.caddy (one file per project); Caddy reloads with:
#   docker compose -f /srv/edge/compose.yml exec caddy caddy reload --config /etc/caddy/Caddyfile
# A booking link's token opens the booking (Ýeral, book Q-168): every log shows /l/… and /v1/links/… without it. The
# sites' access logs filter it themselves; this covers the default log, where handler errors (a 502) land.
{
	log default {
		format filter {
			wrap json
			fields {
				request>uri regexp "(/l/|/v1/links/)[^/?]+" "${1}…"
			}
		}
	}
}

import sites/*.caddy

# Anything else (the bare IP, unknown hosts) gets nothing.
:80 {
	respond 404
}
