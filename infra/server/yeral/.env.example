# /srv/yeral/.env on the server only (mode 600). deploy.sh creates it with a random password the first time.
POSTGRES_PASSWORD=
# the key the Ýeral team's authenticator secrets are sealed under (ADR 0026); deploy.sh adds one the first time.
# Losing it means every admin account sets up its app again from a reset link (`admin-invite`).
ADMIN_SECRET_KEY=
# The ways to reach Ýeral (book F-174): Contact Ýeral in the sites (baked in at build time by deploy.sh) and the
# example businesses' phone (the api). Set by hand, never in the repo; one left empty isn't shown. Placeholders here.
YERAL_SUPPORT_PHONE=+99312345678
YERAL_SUPPORT_TELEGRAM=yeral_support
YERAL_SUPPORT_EMAIL=hello@example.com
