# Ýeral's sites on the shared Caddy. deploy.sh copies this file to /srv/edge/sites/ once the DNS records exist
# (DNS only, not proxied), so Caddy can get the certificates. The cms host joins with its app; until then cms.
# resolves here and gets a certificate error. The records: infra/server/README.md, "DNS records".
# Only A records for now: Docker's edge network has no IPv6, so a visitor over IPv6 would reach Caddy as the Docker
# gateway and every such visitor would share one rate-limit bucket (infra/server/README.md, "Still to do").
# The hosts are written here because Caddy needs them; the apps read theirs from config (@yeral/lib/site).

# what every Ýeral site sends and logs (infra/server/README.md, "Security headers")
(yeral_site) {
	encode zstd gzip
	header {
		# a year of HTTPS only, for every *.yeral.app host (all of them are on TLS: README, "DNS records"); no `preload`,
		# which couldn't be undone quickly
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		-Server
	}
	# access log as JSON lines on stderr (Docker keeps them, rotated); cookies are logged empty
	log {
		# a booking link's token opens the booking (book Q-168), a setup link's an admin account (ADR 0026): logged as /l/…,
		# /v1/links/…, /setup/… and /v1/admin/setup/…
		format filter {
			wrap json
			fields {
				request>uri regexp "(^/setup/|/l/|/v1/links/|/v1/admin/setup/)[^/?]+" "${1}…"
			}
		}
	}
}

api.yeral.app {
	import yeral_site
	# a photo is 10 MB at most (PHOTO_MAX_BYTES, @yeral/domain/photos); the form around it adds a few bytes
	request_body {
		max_size 11MB
	}
	# JSON, photos and the OpenAPI document load nothing and belong in no frame; the docs page (/docs) is Scalar's
	# bundle from a CDN, whose needs aren't in the inventory yet, so it keeps only the directives that don't govern
	# loading (README, "Security headers")
	@docs path /docs
	@not_docs not path /docs
	header @not_docs Content-Security-Policy "default-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
	header @docs Content-Security-Policy "frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
	# Caddy writes the caller's address into X-Forwarded-For and drops what the caller sent (TRUSTED_IP_HEADER); the
	# events stream (`/v1/events/stream`, text/event-stream) goes through at once: reverse_proxy flushes it, and `encode`
	# leaves its `no-transform` answer alone (checked in CI's Docker stack)
	reverse_proxy yeral-api:3004
}

# the business app (since 25.10.2026): its image serves the files (static.Caddyfile, noindex); this door adds TLS and
# the headers
business.yeral.app {
	import yeral_site
	# a static build with no inline script; styles: React and MapLibre set style attributes, the workspace shell and
	# MapLibre add a <style>; images: uploaded photos from the api, MapLibre's blobs and transparent data: pixel; the font
	# is bundled; the api (requests, the events stream) and OpenFreeMap (style, glyphs, sprites, tiles) over fetch;
	# MapLibre's worker from a blob. The inventory: docs/memory-bank/log/2026-10-30-hsts-csp.md
	header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://api.yeral.app; font-src 'self'; connect-src 'self' https://api.yeral.app https://tiles.openfreemap.org; worker-src blob:; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'"
	reverse_proxy yeral-business:80
}

# the client site (since 25.10.2026, the owner: replacing the coming-soon page so slice 3's booking can be tried live):
# its image renders the pages (client.Dockerfile). Kept out of search engines until the first launch opens. Its
# Content-Security-Policy comes from the app itself (apps/client/src/app/entrypoint/csp.ts): every page gets a nonce
# for the scripts TanStack Start writes inline, which no fixed header here could name.
yeral.app {
	import yeral_site
	header X-Robots-Tag "noindex, nofollow"
	reverse_proxy yeral-client:3000
}

www.yeral.app {
	redir https://yeral.app{uri} permanent
}
