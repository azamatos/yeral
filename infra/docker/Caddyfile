# The production-like stack's front door, like the server's shared Caddy (infra/server/edge, yeral.caddy), on plain
# HTTP: *.localhost resolves to this machine without /etc/hosts. The cms host joins with its app.
{
	auto_https off
	# a booking link's token opens the booking (book Q-168), a setup link's an admin account (ADR 0026): handler errors log
	# /l/…, /v1/links/…, /setup/… and /v1/admin/setup/… without it
	log default {
		format filter {
			wrap json
			fields {
				request>uri regexp "(^/setup/|/l/|/v1/links/|/v1/admin/setup/)[^/?]+" "${1}…"
			}
		}
	}
}

http://api.yeral.localhost {
	encode zstd gzip
	# a photo is 10 MB at most (PHOTO_MAX_BYTES, @yeral/domain/photos); the form around it adds a few bytes
	request_body {
		max_size 11MB
	}
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		-Server
	}
	log {
		# a booking link's token opens the booking (book Q-168), a setup link's an admin account (ADR 0026): logged as /l/…,
		# /v1/links/…, /setup/… and /v1/admin/setup/…
		format filter {
			wrap json
			fields {
				request>uri regexp "(^/setup/|/l/|/v1/links/|/v1/admin/setup/)[^/?]+" "${1}…"
			}
		}
	}
	# Caddy writes the caller's address into X-Forwarded-For and drops what the caller sent (TRUSTED_IP_HEADER)
	reverse_proxy api:3004
}

# the client site: its Node server renders the pages and serves the files (client.Dockerfile); this door adds the
# headers and compresses
http://yeral.localhost {
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		-Server
	}
	log {
		# a booking link's token opens the booking (book Q-168; yeral.app/l/…): logged as /l/…
		format filter {
			wrap json
			fields {
				request>uri regexp "(/l/|/v1/links/)[^/?]+" "${1}…"
			}
		}
	}
	reverse_proxy client:3000
}

# the business app: its image serves the files (static.Caddyfile); this door adds the headers
http://business.yeral.localhost {
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		-Server
	}
	log
	reverse_proxy business:80
}

# unknown hosts get nothing
:80 {
	respond 404
}
