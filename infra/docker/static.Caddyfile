# Serves a single-page app's static build from /srv inside its image (business, later cms). The stack's front door
# (Caddyfile here, infra/server/edge on the server) adds TLS and the security headers and proxies to it.
{
	admin off
	auto_https off
}

:80 {
	root * /srv
	encode zstd gzip
	# a workspace behind a sign-in: never in search engines
	header X-Robots-Tag "noindex, nofollow"

	# hashed files never change; one that isn't there is a 404, never the page (a tab still on the last build asks
	# for its old chunks, and a cached page under a script's address would break it for a year)
	handle /assets/* {
		@exists file
		header @exists Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# every other address the router knows is the app itself, asked for again each time
	handle {
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
