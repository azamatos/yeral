# Serves a single-page app's static build from /srv inside its image (business, later cms). The stack's front door
# (Caddyfile here, infra/server/edge on the server) adds TLS and the security headers and proxies to it.
{
	admin off
	auto_https off
}

:80 {
	root * /srv
	encode zstd gzip
	# every address the router knows is the app itself
	try_files {path} /index.html
	# hashed files never change; the page and the stamp are always asked for again
	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@fresh not path /assets/*
	header @fresh Cache-Control "no-cache"
	# a workspace behind a sign-in: never in search engines
	header X-Robots-Tag "noindex, nofollow"
	file_server
}
