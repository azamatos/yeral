{
  "name": "@yeral/client",
  "version": "0.1.0",
  "private": true,
  "description": "Ýeral: the client site at <domain> (TanStack Start: SSR for public pages, client-only for the account and login)",
  "type": "module",
  "scripts": {
    "dev": "vite dev --port $(( ${PORT_BASE:-3000} + 1 )) --strictPort",
    "build": "vite build && esbuild server.mjs --bundle --platform=node --format=esm --target=node24 --external:./server/* --outfile=dist/node.mjs --log-level=warning && node ../../scripts/version-stamp.mjs client dist/client",
    "start": "node dist/node.mjs",
    "lint": "eslint .",
    "lint:fsd": "steiger ./src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-router": "catalog:",
    "@tanstack/react-router-ssr-query": "catalog:",
    "@tanstack/react-start": "catalog:",
    "@yeral/contract": "workspace:*",
    "@yeral/domain": "workspace:*",
    "@yeral/features": "workspace:*",
    "@yeral/i18n": "workspace:*",
    "@yeral/lib": "workspace:*",
    "@yeral/sdk": "workspace:*",
    "@yeral/ui": "workspace:*",
    "hono": "catalog:",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "use-intl": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@babel/core": "catalog:",
    "@rolldown/plugin-babel": "catalog:",
    "@storybook/react-vite": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@yeral/config": "workspace:*",
    "babel-plugin-react-compiler": "catalog:",
    "esbuild": "catalog:",
    "eslint": "catalog:",
    "steiger": "catalog:",
    "storybook": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
