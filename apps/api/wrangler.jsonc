{
  "$schema": "node_modules/wrangler/config-schema.json",
  // the api on Cloudflare Workers (ADR 0007); deploy with `pnpm run deploy:staging` (CI after the owner's one-time setup)
  "name": "yeral-api",
  "account_id": "90af7d87d8b4cc5e517a859f6413f96e",
  "main": "src/entry/worker.ts",
  "compatibility_date": "2026-10-01",
  // node-postgres needs Node's net/tls APIs
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "env": {
    "staging": {
      "name": "yeral-api-stage",
      "routes": [{ "pattern": "api-stage.yeral.app", "custom_domain": true }],
      "vars": { "YERAL_ENV": "staging", "YERAL_DOMAIN": "yeral.app", "MEDIA_BASE_URL": "https://stage.yeral.app/media" },
      // Hyperdrive config "yeral-stage" → Neon branch "stage" (created by the owner's go-ahead, operations.md)
      "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "00000000000000000000000000000000" }],
      "triggers": { "crons": ["* * * * *"] },
    },
  },
}
