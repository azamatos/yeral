{
  "$schema": "node_modules/wrangler/config-schema.json",
  // the api on Cloudflare Workers (ADR 0007); deploy with `pnpm run deploy:staging` (CI after the owner's one-time setup).
  // The top level is not an environment: it has no database binding (every request fails with a clear log line) and
  // no URL (no route, no workers.dev), so always pass --env.
  "name": "yeral-api",
  "workers_dev": false,
  "account_id": "90af7d87d8b4cc5e517a859f6413f96e",
  "main": "src/entry/worker.ts",
  "compatibility_date": "2026-10-01",
  // node-postgres needs Node's net/tls APIs
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "env": {
    "staging": {
      "name": "yeral-api-stage",
      "routes": [{ "pattern": "api-stage.yeral.app", "custom_domain": true }],
      "vars": {
        "YERAL_ENV": "staging",
        "YERAL_DOMAIN": "yeral.app",
        "MEDIA_BASE_URL": "https://stage.yeral.app/media",
        // client IPs for rate limits: Cloudflare's header
        "TRUSTED_IP_HEADER": "cf-connecting-ip",
      },
      // Hyperdrive config "yeral-stage" → Neon branch "stage" (created by the owner's go-ahead, operations.md)
      "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "00000000000000000000000000000000" }],
      "triggers": { "crons": ["* * * * *"] },
    },
  },
}
