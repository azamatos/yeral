{
  "$schema": "node_modules/wrangler/config-schema.json",
  // the api on Cloudflare Workers (ADR 0007); production only, no staging (ADR 0020). Deployed with
  // `pnpm run deploy:production` once the owner has created the Neon production branch, the Hyperdrive config and the
  // api.yeral.app record (operations.md) — not before the new client site (M3).
  // The top level is not an environment: it has no database binding (every request fails with a clear log line) and
  // no URL (no route, no workers.dev), so always pass --env.
  "name": "yeral-api",
  "workers_dev": false,
  "account_id": "90af7d87d8b4cc5e517a859f6413f96e",
  "main": "src/entry/worker.ts",
  "compatibility_date": "2026-10-01",
  // node-postgres needs Node's net/tls APIs
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "env": {
    "production": {
      "name": "yeral-api",
      "routes": [{ "pattern": "api.yeral.app", "custom_domain": true }],
      "vars": {
        "YERAL_ENV": "production",
        "YERAL_DOMAIN": "yeral.app",
        "MEDIA_BASE_URL": "https://yeral.app/media",
        // client IPs for rate limits: Cloudflare's header
        "TRUSTED_IP_HEADER": "cf-connecting-ip",
      },
      // Hyperdrive config "yeral-production" → the Neon production branch, caching off (operations.md)
      "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "00000000000000000000000000000000" }],
      "triggers": { "crons": ["* * * * *"] },
    },
  },
}
