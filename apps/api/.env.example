# Local development (copy to .env.local). Never point this at the production database on the own server.
# The port follows YERAL_DB_PORT of `pnpm db:up` (5433 when another Postgres holds 5432 on this machine).
DATABASE_URL=postgres://yeral:yeral@localhost:5432/yeral
YERAL_ENV=local
YERAL_DOMAIN=yeral.app
# PORT_BASE=3100            # in a second worktree
# MEDIA_BASE_URL=           # default <api>/media; demo photos are served from docs/design/assets/photos
# LOG_LEVEL=info
# TRUSTED_IP_HEADER=        # x-forwarded-for behind Caddy (its last entry: the caller's IP for rate limits).
#                           # Unset = no header is trusted.
# TEST_DATABASE_URL=postgres://yeral:yeral@localhost:5432/postgres   # API tests (admin connection)
