{
  "name": "@yeral/cms",
  "version": "0.1.0",
  "private": true,
  "description": "Ýeral Admin: the Ýeral team's tool at cms.<domain> (Vite SPA + TanStack Router)",
  "type": "module",
  "scripts": {
    "dev": "vite --port $(( ${PORT_BASE:-3000} + 3 )) --strictPort",
    "build": "vite build && node ../../scripts/version-stamp.mjs cms dist",
    "preview": "vite preview --port $(( ${PORT_BASE:-3000} + 3 )) --strictPort",
    "lint": "eslint .",
    "lint:fsd": "steiger ./src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-router": "catalog:",
    "@yeral/contract": "workspace:*",
    "@yeral/domain": "workspace:*",
    "@yeral/i18n": "workspace:*",
    "@yeral/lib": "workspace:*",
    "@yeral/sdk": "workspace:*",
    "@yeral/ui": "workspace:*",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "use-intl": "catalog:"
  },
  "devDependencies": {
    "@babel/core": "catalog:",
    "@rolldown/plugin-babel": "catalog:",
    "@storybook/react-vite": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/router-plugin": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@yeral/config": "workspace:*",
    "babel-plugin-react-compiler": "catalog:",
    "eslint": "catalog:",
    "steiger": "catalog:",
    "storybook": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
