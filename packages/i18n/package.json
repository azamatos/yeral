{
  "name": "@yeral/i18n",
  "version": "0.0.0",
  "private": true,
  "description": "Ýeral languages (tk default, ru, en): shared messages and formatters for money, prices, durations, dates and distances",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./messages/*.json": "./src/messages/*.json"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@yeral/domain": "workspace:*",
    "use-intl": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@yeral/config": "workspace:*",
    "eslint": "catalog:",
    "react": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
